FROM maven:3.9-eclipse-temurin-11 AS builder
WORKDIR /app
ENV MAVEN_OPTS="-Dmaven.wagon.http.pool=false -Dmaven.wagon.httpconnectionManager.ttlSeconds=120 -Dmaven.wagon.http.retryHandler.count=5 -Dhttp.keepAlive=false"
COPY maven-settings.xml /root/.m2/settings.xml
COPY pom.xml ./
RUN mvn -B -s /root/.m2/settings.xml -Dmaven.wagon.rto=300000 dependency:go-offline
COPY src ./src
RUN mvn -B -s /root/.m2/settings.xml -Dmaven.wagon.rto=300000 package -DskipTests

FROM eclipse-temurin:8-jre-alpine
WORKDIR /app
RUN apk add --no-cache bash netcat-openbsd
COPY --from=builder /app/target/*.jar app.jar
COPY wait-for-it.sh /wait-for-it.sh
RUN chmod +x /wait-for-it.sh
EXPOSE 8085
ENTRYPOINT ["java", "-jar", "app.jar"]

















Вот готовый материал для защиты. Код оформлен с подробными комментариями через `#`, ниже идут ответы на частые вопросы проверяющих и готовый монолог.

### 📄 Файл `Dockerfile` с комментариями для защиты

```dockerfile
# ПЕРВАЯ СТАДИЯ: Сборка приложения (Builder)
# Используем официальный образ Maven 3.9 с JDK 11 от Eclipse Temurin (надёжная сборка OpenJDK).
# "AS builder" даёт имя этому этапу, чтобы во второй стадии можно было скопировать файлы отсюда.
# Это называется "многостадийная сборка" (multi-stage build): собираем в тяжёлом образе, запускаем в лёгком.
FROM maven:3.9-eclipse-temurin-11 AS builder

# Создаём рабочую директорию /app внутри контейнера и переходим в неё.
# Все следующие команды (COPY, RUN) будут выполняться внутри этой папки.
WORKDIR /app

# Настраиваем переменные окружения для Maven, чтобы сборка не падала из-за проблем с сетью.
# MAVEN_OPTS — флаги для борьбы с "зависаниями" при скачивании библиотек:
# -Dmaven.wagon.http.pool=false — отключает пул соединений, предотвращает использование "протухших" каналов.
# -Dmaven.wagon.httpconnectionManager.ttlSeconds=120 — время жизни соединения 120 сек (обновляет каналы).
# -Dmaven.wagon.http.retryHandler.count=5 — автоматически повторяет скачивание до 5 раз при обрыве связи.
# -Dhttp.keepAlive=false — отключает постоянное соединение HTTP, решает проблемы с некоторыми прокси/файрволами.
ENV MAVEN_OPTS="-Dmaven.wagon.http.pool=false -Dmaven.wagon.httpconnectionManager.ttlSeconds=120 -Dmaven.wagon.http.retryHandler.count=5 -Dhttp.keepAlive=false"

# Копируем кастомный settings.xml. В нём обычно прописаны зеркала (mirrors) репозиториев,
# чтобы ускорить скачивание зависимостей в регионах с ограниченным доступом к central.maven.org.
COPY maven-settings.xml /root/.m2/settings.xml

# Копируем ТОЛЬКО файл зависимостей pom.xml.
# Docker кэширует слои. Если код не менялся, а pom.xml изменился — кэш библиотек инвалидируется корректно.
# Это позволяет не скачивать сотни библиотек заново при каждом изменении строчки кода.
COPY pom.xml ./

# Скачиваем все зависимости БЕЗ компиляции кода.
# dependency:go-offline — команда Maven, которая резолвит и скачивает всё, что указано в pom.xml.
# Это создаёт отдельный слой кэша. При изменении исходного кода Docker не будет заново качать библиотеки,
# что ускоряет повторные сборки в разы. -Dmaven.wagon.rto=300000 — таймаут чтения 5 минут (300 сек) на случай медленной сети.
RUN mvn -B -s /root/.m2/settings.xml -Dmaven.wagon.rto=300000 dependency:go-offline

# Копируем исходный код. Этот слой кэшируется отдельно от зависимостей.
# Так как pom.xml уже скопирован и зависимости скачаны, этот шаг будет быстрым.
COPY src ./src

# Компилируем проект и упаковываем в JAR-файл.
# -B — batch mode (не задаёт вопросов, не интерактивный), -s — путь к настройкам.
# -DskipTests — пропускаем тесты. В CI/CD тесты должны запускаться ДО сборки образа.
# Dockerfile отвечает только за упаковку готового артефакта, а не за QA (контроль качества).
RUN mvn -B -s /root/.m2/settings.xml -Dmaven.wagon.rto=300000 package -DskipTests

# ВТОРАЯ СТАДИЯ: Запуск приложения (Runtime)
# Берём минимальный образ с JRE 8 на базе Alpine Linux.
# JRE (Java Runtime Environment) не содержит компилятор, поэтому образ легче.
# Alpine весит ~5 МБ, что критично для скорости доставки в кластер и экономии места.
FROM eclipse-temurin:8-jre-alpine

# Создаём рабочую директорию в финальном образе.
WORKDIR /app

# Устанавливаем утилиты через пакетный менеджер Alpine (apk):
# bash — оболочка для выполнения скриптов (в Alpine по умолчанию стоит более простой sh).
# netcat-openbsd (команда nc) — нужна для скрипта wait-for-it.sh, чтобы проверять доступность портов.
# --no-cache — не сохранять кэш пакетов после установки, чтобы не раздувать итоговый размер образа.
RUN apk add --no-cache bash netcat-openbsd

# Копируем собранный JAR-файл из первой стадии (builder) в текущий образ.
# "--from=builder" говорит Docker взять файл из предыдущего этапа.
# В итоговый образ попадёт ТОЛЬКО app.jar, весь Maven, исходники и кэш библиотек останутся в builder-стадии.
# Это безопасно (никто не украдёт исходный код из продакшен-образа) и экономит место на диске.
COPY --from=builder /app/target/*.jar app.jar

# Копируем скрипт-помощник wait-for-it.sh.
# Он будет ждать готовности зависимостей (БД, другие сервисы) перед стартом Java-приложения.
# Это критично для микросервисов: приложение не должно падать, если база данных ещё не приняла подключения.
COPY wait-for-it.sh /wait-for-it.sh

# Даём права на выполнение скрипту (+x), иначе ядро Linux не позволит его запустить.
# Без этой команды при старте контейнера будет ошибка "Permission denied".
RUN chmod +x /wait-for-it.sh

# EXPOSE 8085 — документационная метка. Сообщает, что этот микросервис (Loyalty Service) слушает порт 8085.
# Не открывает порт автоматически, но помогает Docker Compose и оркестратору понимать конфигурацию сети.
# Порт 8085 — стандартный для этого сервиса в нашей архитектуре.
EXPOSE 8085

# ENTRYPOINT — команда, которая выполнится при запуске контейнера.
# По умолчанию запускает Java с нашим JAR-файлом.
# Важно: в docker-compose.yml этот entrypoint переопределяется, чтобы перед java добавить "/wait-for-it.sh ... --",
# обеспечивая порядок запуска в распределённой системе (сначала ждём БД, потом стартуем приложение).
# Формат ["exec", "args"] (exec form) важен, чтобы Java получила сигналы завершения (SIGTERM) от Docker корректно.
ENTRYPOINT ["java", "-jar", "app.jar"]
```

---

### ❓ Возможные вопросы на защите и ответы на них

**1. Зачем отдельно запускать `dependency:go-offline`, если потом всё равно будет `package`?**
> *Ответ:* Это оптимизация кэширования слоёв Docker. Зависимости в `pom.xml` меняются редко, а код в `src/` — часто. Если копировать `src` и запускать `package` сразу, любое изменение в коде заставит Docker заново скачивать сотни библиотек из интернета. Разделение на два `RUN`-шага позволяет Docker использовать кэш зависимостей, ускоряя повторные сборки с минут до секунд.

**2. Почему вы используете `-DskipTests`? Разве тесты не важны?**
> *Ответ:* Тесты важны, но место их запуска — этап CI/CD (непрерывной интеграции), а не сборка образа. `Dockerfile` должен быть идемпотентным и быстрым инструментом упаковки. Если тесты падают, пайплайн сборки должен остановиться до стадии `docker build`. Пропуск тестов в Dockerfile — стандартная практика для ускорения доставки артефактов, особенно когда образ пересобирается часто.

**3. Что делают флаги в `MAVEN_OPTS`? Почему их так много?**
> *Ответ:* Это "анти-зависание" для Maven в нестабильных сетях. По умолчанию Maven использует пулы соединений и keep-alive, которые в некоторых корпоративных прокси или при плохом интернете "залипают" и сборка висит часами. Отключение пула (`pool=false`), keep-alive и включение ретраев (`retryHandler.count=5`) заставляет Maven создавать новое соединение для каждого запроса и автоматически повторять скачивание при обрыве. Это гарантирует, что сборка дойдёт до конца даже при плохой связи.

**4. Почему сборка на Java 11, а запуск на Java 8?**
> *Ответ:* Это допустимая практика обратной совместимости. Компилятор Java 11 может генерировать байт-код, совместимый с более старой JVM (флаг `source/target` в `pom.xml` обычно настроен на 1.8). Мы используем такую схему, потому что наше приложение (или его зависимости) требуют компилятор новой версии для сборки, а для рантайма берём JRE 8 Alpine, потому что он стабильнее, меньше весит и полностью покрывает потребности нашего микросервиса.

**5. Зачем нужен `netcat-openbsd` в Alpine?**
> *Ответ:* В минималистичном Alpine Linux нет утилит для проверки сетевых портов "из коробки". Скрипт `wait-for-it.sh`, который мы используем для синхронизации запуска микросервисов, internally использует `nc` (netcat) для опроса портов зависимостей. Без установки `netcat-openbsd` скрипт упадёт с ошибкой `command not found`, и контейнер не стартует.

---

### 🎤 Монолог для защиты (1 абзац)

Данный `Dockerfile` реализует оптимизированную многостадийную сборку (multi-stage build) Java-микросервиса лояльности, где первый этап на базе Maven JDK 11 отвечает за резолв и кэширование зависимостей через отдельный шаг `dependency:go-offline`, что позволяет Docker переиспользовать слой библиотек при изменении исходного кода и ускоряет повторные сборки, а специальные флаги `MAVEN_OPTS` отключают агрессивное переиспользование HTTP-соединений и включают автоматические ретраи для гарантии успешной загрузки артефактов в нестабильных сетях; второй этап формирует минимальный рантайм на базе Alpine Linux с JRE 8, куда копируется только скомпилированный JAR-файл и утилиты `bash`/`netcat`, необходимые для скрипта синхронизации запуска, что снижает итоговый размер образа, ускоряет доставку в кластер и обеспечивает безопасный, детерминированный старт сервиса только после готовности всех внешних зависимостей.