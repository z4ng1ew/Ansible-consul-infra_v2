Vagrant.configure("2") do |config|
  config.vm.box = "ubuntu/jammy64"

  # Consul Server
  config.vm.define "consul_server" do |cs|
    cs.vm.hostname = "consul-server"
    cs.vm.network "private_network", ip: "192.168.56.20"
    cs.vm.network "forwarded_port", guest: 8500, host: 8500
    cs.vm.provider "virtualbox" do |vb|
      vb.memory = "512"
      vb.cpus = 1
      vb.name = "consul_server"
    end
  end

  # API service
  config.vm.define "api" do |api|
    api.vm.hostname = "api"
    api.vm.network "private_network", ip: "192.168.56.21"
    api.vm.network "forwarded_port", guest: 8082, host: 8082
    api.vm.provider "virtualbox" do |vb|
      vb.memory = "2048"
      vb.cpus = 2
      vb.name = "api"
    end
  end

  # Manager
  config.vm.define "manager2" do |mgr|
    mgr.vm.hostname = "manager2"
    mgr.vm.network "private_network", ip: "192.168.56.22"
    mgr.vm.provider "virtualbox" do |vb|
      vb.memory = "512"
      vb.cpus = 1
      vb.name = "manager2"
    end
    mgr.vm.provision "shell", inline: <<-SHELL
      apt-get update
      apt-get install -y ansible
    SHELL
  end

  # Database
  config.vm.define "db" do |db|
    db.vm.hostname = "db"
    db.vm.network "private_network", ip: "192.168.56.23"
    db.vm.provider "virtualbox" do |vb|
      vb.memory = "1024"
      vb.cpus = 1
      vb.name = "db"
    end
  end
end
