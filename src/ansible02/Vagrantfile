VAGRANTFILE_API_VERSION = "2"

Vagrant.configure(VAGRANTFILE_API_VERSION) do |config|
  # Используем тот же кастомный бокс, что и в Part 1
  config.vm.box = "my-ubuntu2204"

  config.ssh.insert_key = false
  config.vm.synced_folder ".", "/vagrant", disabled: true

  config.vm.provider "libvirt" do |libvirt|
    libvirt.uri      = 'qemu:///system'
    libvirt.driver   = "kvm"
    libvirt.memory   = 1024
    libvirt.cpus     = 1
    libvirt.nested   = true
    libvirt.qemu_use_agent = true
  end

  config.vm.boot_timeout = 600

  # consul_server: 192.168.56.20
  config.vm.define "consul_server" do |cs|
    cs.vm.hostname = "consul-server"
    cs.vm.network "private_network",
      ip: "192.168.56.20",
      libvirt__network_name: "vagrant-private",
      mac: "525400222220",
      auto_config: false
    cs.vm.network "forwarded_port", guest: 8500, host: 8500
  end

  # api: 192.168.56.21
  config.vm.define "api" do |api|
    api.vm.hostname = "api"
    api.vm.provider "libvirt" do |lv|
      lv.memory = 2048
      lv.cpus   = 2
    end
    api.vm.network "private_network",
      ip: "192.168.56.21",
      libvirt__network_name: "vagrant-private",
      mac: "525400222221",
      auto_config: false
    api.vm.network "forwarded_port", guest: 8082, host: 8082
  end

  # db: 192.168.56.23
  config.vm.define "db" do |db|
    db.vm.hostname = "db"
    db.vm.network "private_network",
      ip: "192.168.56.23",
      libvirt__network_name: "vagrant-private",
      mac: "525400222223",
      auto_config: false
  end
end
